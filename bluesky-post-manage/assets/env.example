# Bluesky / AT Protocol credentials.
# Copy to ~/.agents/.env and fill in real values.
#
# Generate app passwords at: Settings → Privacy and Security → App Passwords
# Resolve a handle's DID:
#   bash ~/.agents/skills/bluesky-post-manage/scripts/resolve-did.sh YOUR_HANDLE

# ── Account: MAIN ──────────────────────────────────────────────────────────────
BSKY_ACCOUNT_MAIN_HANDLE=yourhandle.bsky.social
BSKY_ACCOUNT_MAIN_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
BSKY_ACCOUNT_MAIN_DID=did:plc:xxxxxxxxxxxxxxxxxxxxxxxx
BSKY_ACCOUNT_MAIN_PDS_URL=https://bsky.social

# ── Account: BOT ───────────────────────────────────────────────────────────────
# BSKY_ACCOUNT_BOT_HANDLE=yourbot.bsky.social
# BSKY_ACCOUNT_BOT_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# BSKY_ACCOUNT_BOT_DID=did:plc:xxxxxxxxxxxxxxxxxxxxxxxx
# BSKY_ACCOUNT_BOT_PDS_URL=https://bsky.social

# ── Account: BRAND ─────────────────────────────────────────────────────────────
# BSKY_ACCOUNT_BRAND_HANDLE=yourbrand.bsky.social
# BSKY_ACCOUNT_BRAND_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# BSKY_ACCOUNT_BRAND_DID=did:plc:xxxxxxxxxxxxxxxxxxxxxxxx
# BSKY_ACCOUNT_BRAND_PDS_URL=https://bsky.social

# Add accounts by copying a block above and renaming the prefix (e.g. PERSONAL, WORK).
# After adding, register the account in:
#   ~/.agents/skills/bluesky-post-manage/references/accounts.md
